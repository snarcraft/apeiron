# ── never committed ─────────────────────────────────────────
node_modules

.env
test.env
local.env
staging.env
production.env
# secrets/ ignores itself — real values (incl. provision.env with
# the IAM keys the provisioner mints) never enter git
.DS_Store
*.log
.php-cs-fixer.cache
.phpunit.result.cache

# ── committed on purpose ────────────────────────────────────
# assets/          — brand source of truth (icon.svg, manifest);
#                    PWA sizes regenerate from it, copies land in
#                    apps/*/public and are committed too
# docs/            — SECRETS.md carries key NAMES and commands,
#                    never values
# secrets/.gitignore — the only tracked file in secrets/
