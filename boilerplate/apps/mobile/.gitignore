# Generated code — regenerated by build_runner on every machine
**.freezed.dart
**.g.dart
**.gr.dart
**.config.dart

# The local bootstrap config — lives in secrets/, linked or
# materialized from the APP_CONFIG CI secret (like backend .env)
assets/app.json

# Flutter build artifacts
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/

# Platform signing secrets — materialized by CI
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
